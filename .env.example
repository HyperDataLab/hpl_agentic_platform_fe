# Local development: copy to .env.local. Every value here is baked into the static export at build time
# and is public. Never put a secret here: the 9router key is typed in Settings and kept in localStorage only.

# Public origin, for absolute links in share previews, the sitemap and robots.txt.
SITE_URL=https://hyperdatalab-idea2hypo.web.app

# The i2h-worker (Cloudflare) that starts runs and streams their events. `wrangler dev` listens on 8787.
NEXT_PUBLIC_I2H_WORKER_URL=http://localhost:8787
# PaperLab's PDF worker, for the corpus picker when starting a run.
NEXT_PUBLIC_PAPERLAB_WORKER_URL=https://paperlab-pdf-worker.hyperdatalab.workers.dev

# Firebase web config of the hyperdatalab-idea2hypo project (Project settings → Your apps). Not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hyperdatalab-idea2hypo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hyperdatalab-idea2hypo
NEXT_PUBLIC_FIREBASE_APP_ID=

# "1" connects to the Auth (127.0.0.1:9099) and Firestore (127.0.0.1:8085) emulators of
# `firebase emulators:start --only hosting,auth,firestore`. Use a demo-* project id with it.
NEXT_PUBLIC_FIREBASE_EMULATORS=

# Defaults for Settings → Language model. The person can change them; the key has no default.
NEXT_PUBLIC_LLM_BASE_URL=https://9router.oraltest.site/v1
NEXT_PUBLIC_LLM_MODEL=cx/gpt-6-luna
